#!/bin/sh
# One-command dotfiles sync across machines: commit local changes, rebase-pull, push.
# Usage: dots [commit message]   (default message: dated sync note)
cd "$HOME/.dotfiles" || exit 1
MSG="$1"
if [ -n "$(git status --porcelain)" ]; then
    [ -n "$MSG" ] || MSG="dots: sync from $(hostname) $(date +%F)"
    git add -A && git commit -m "$MSG" || exit 1
    echo "dots: committed \"$MSG\""
fi
if ! git pull --rebase --autostash origin master; then
    echo "dots: origin unreachable — trying hub (lenovo)"
    git pull --rebase --autostash hub master || exit 1
fi
OK=0
git push origin master && OK=1 || echo "dots: origin push failed"
git push hub master && OK=1 || echo "dots: hub push failed"
[ "$OK" = "1" ] || { echo "dots: no remote accepted the push"; exit 1; }
echo "dots: in sync at $(git log --oneline -1)"
